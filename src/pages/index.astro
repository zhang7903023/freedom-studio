---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import CategoryList from "../components/CategoryList.astro";
import { SITE, ABOUT, SERVICES } from "../config";
import { getPublishedPosts } from "../utils/posts";

const posts = await getPublishedPosts();
const latest = posts.slice(0, 6);
const featured = posts.filter((p) => p.data.featured).slice(0, 3);
---

<BaseLayout
  description={SITE.homeDescription}
  path="/"
  includeSiteSchema={true}
>
  <!-- 首屏 -->
  <section class="hero">
    <div class="container">
      <h1 class="hero-title fade-in">{SITE.name}</h1>
      <p class="hero-tagline fade-in">{SITE.tagline}</p>
      <p class="hero-desc fade-in">{SITE.description}</p>
      <div class="hero-actions fade-in">
        <a href="/blog/" class="btn btn-primary">阅读文章</a>
        <a href="/services/" class="btn btn-ghost">了解服务</a>
      </div>
    </div>
  </section>

  <!-- 最新文章 -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="section-title">最新文章</h2>
        </div>
        <a href="/blog/" class="more">查看全部 →</a>
      </div>
      <div class="article-grid">
        {latest.map((post) => <ArticleCard post={post} />)}
      </div>
    </div>
  </section>

  <!-- 内容分类 -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">内容分类</h2>
      <p class="section-sub">按主题浏览，每个分类只写真实做过的事。</p>
      <CategoryList />
    </div>
  </section>

  <!-- 精选文章 -->
  {featured.length > 0 && (
    <section class="section">
      <div class="container">
        <h2 class="section-title">精选文章</h2>
        <p class="section-sub">值得从头读到尾的几篇。</p>
        <div class="article-grid">
          {featured.map((post) => <ArticleCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  <!-- 关于 -->
  <section class="section">
    <div class="container about-block">
      <h2 class="section-title">关于{SITE.name}</h2>
      <p class="about-text">{ABOUT.intro}</p>
      <p class="about-emphasis">{ABOUT.emphasis}</p>
      <a href="/about/" class="more-link">了解更多 →</a>
    </div>
  </section>

  <!-- 服务 -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">可以帮你做什么</h2>
      <p class="section-sub">只列真正做过、能做好的事。</p>
      <ul class="service-list">
        {SERVICES.map((s) => (
          <li>
            <strong>{s.title}</strong>
            <span>{s.description}</span>
          </li>
        ))}
      </ul>
      <div class="service-cta">
        <a href="/contact/" class="btn btn-primary">联系我</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 110px 0 90px;
    text-align: center;
  }
  .hero-title {
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    margin: 0 0 14px;
    letter-spacing: -0.03em;
  }
  .hero-tagline {
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    color: var(--text-secondary);
    margin: 0 0 18px;
    font-weight: 500;
  }
  .hero-desc {
    max-width: 560px;
    margin: 0 auto 36px;
    color: var(--text-secondary);
    font-size: 1.02rem;
  }
  .hero-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .about-block {
    max-width: 680px;
  }
  .about-text {
    color: var(--text-secondary);
    font-size: 1.05rem;
  }
  .about-emphasis {
    color: var(--text);
    font-weight: 500;
    border-left: 3px solid var(--accent);
    padding-left: 16px;
  }
  .more-link {
    display: inline-block;
    margin-top: 8px;
  }

  .service-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 0;
    border-top: 1px solid var(--border);
  }
  .service-list li {
    padding: 22px 4px;
    border-bottom: 1px solid var(--border);
  }
  .service-list li strong {
    display: block;
    font-size: 1.02rem;
    margin-bottom: 6px;
  }
  .service-list li span {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.65;
  }
  .service-cta {
    margin-top: 36px;
  }
</style>
