---
import { SITE, SOCIAL, CONTACT } from "../config";

const year = new Date().getFullYear();

const socialItems = [
  { label: "X", href: SOCIAL.x },
  { label: "YouTube", href: SOCIAL.youtube },
  { label: "Telegram", href: SOCIAL.telegram },
].filter((s) => s.href);

const contactItems = [
  { label: "Email", href: CONTACT.email ? `mailto:${CONTACT.email}` : "" },
].filter((c) => c.href);
---

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <strong>{SITE.name}</strong>
        <p>{SITE.tagline}</p>
      </div>
      {(socialItems.length > 0 || contactItems.length > 0) && (
        <div class="footer-links">
          <ul>
            {contactItems.map((c) => (
              <li><a href={c.href}>{c.label}</a></li>
            ))}
            {socialItems.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
    <div class="footer-bottom">
      <span>© {year} {SITE.name} · 记录真实的互联网实践</span>
      <span class="footer-meta">
        <a href="/rss.xml">RSS</a>
        <a href="/sitemap-index.xml">站点地图</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }
  .footer-brand strong {
    color: var(--text);
    font-size: 1rem;
  }
  .footer-brand p {
    margin: 6px 0 0;
  }
  .footer-links ul {
    list-style: none;
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 0;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }
  .footer-meta {
    display: flex;
    gap: 16px;
  }
</style>
