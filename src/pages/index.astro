---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import CategoryList from "../components/CategoryList.astro";
import { SITE, ABOUT, SERVICES } from "../config";
import { getPublishedPosts } from "../utils/posts";

const posts = await getPublishedPosts();
// 文章目录：最新 6 篇
const latest = posts.slice(0, 6);
---

<BaseLayout
  description={SITE.homeDescription}
  path="/"
  includeSiteSchema={true}
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <h1 class="hero-title">{SITE.heroTitle}</h1>
      <p class="hero-sub">{SITE.tagline}</p>
      <p class="hero-lead">{SITE.description}</p>
      <div class="hero-actions">
        <a href="/blog/" class="btn btn-primary">阅读文章</a>
        <a href="/services/" class="btn btn-ghost">了解服务</a>
      </div>
    </div>
  </section>

  <!-- 文章目录 -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">文章</h2>
        <a href="/blog/" class="more">全部文章 →</a>
      </div>
      <div class="post-list">
        {latest.map((post) => <ArticleCard post={post} />)}
      </div>
    </div>
  </section>

  <!-- 分类标签 -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">分类</h2>
      <p class="section-sub">按主题浏览，每个分类只写真实做过的事。</p>
      <CategoryList />
    </div>
  </section>

  <!-- 关于 | 可以做的事 -->
  <section class="section">
    <div class="container duo">
      <div class="duo-col">
        <h2 class="section-title">关于</h2>
        <p class="duo-text">{ABOUT.intro}</p>
        <a href="/about/" class="more">了解更多 →</a>
      </div>
      <div class="duo-col">
        <h2 class="section-title">可以做的事</h2>
        <ul class="service-list">
          {SERVICES.map((s) => (
            <li>
              <strong>{s.title}</strong>
              <span>{s.description}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: 70vh;
    display: flex;
    align-items: center;
  }
  .hero .container {
    width: 100%;
    padding-top: 40px;
    padding-bottom: 0;
  }
  .hero-title {
    font-size: clamp(3rem, 7vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin: 0 0 18px;
  }
  .hero-sub {
    font-size: 1.375rem;
    font-weight: 500;
    color: var(--muted);
    margin: 0 0 20px;
  }
  .hero-lead {
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1.7;
    color: var(--muted);
    max-width: 560px;
    margin: 0 0 40px;
  }
  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  @media (max-width: 720px) {
    .hero {
      min-height: 56vh;
    }
  }

  .duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
  }
  @media (max-width: 900px) {
    .duo {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
  .duo-text {
    color: var(--muted);
    line-height: 1.75;
    margin: 0 0 16px;
  }

  .service-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .service-list li {
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .service-list li:first-child {
    padding-top: 0;
  }
  .service-list li strong {
    display: block;
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .service-list li span {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.65;
  }
</style>
