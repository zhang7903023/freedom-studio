---
import type { Post } from "../../utils/posts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { SITE } from "../../config";
import { getPublishedPosts, allTags, tagSlug } from "../../utils/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const perPage = 9;
  const totalPages = Math.max(1, Math.ceil(posts.length / perPage));

  const paths: {
    params: { page: string | undefined };
    props: {
      pagePosts: Post[];
      currentPage: number;
      totalPages: number;
      total: number;
      prevUrl: string | undefined;
      nextUrl: string | undefined;
    };
  }[] = [];

  for (let n = 1; n <= totalPages; n++) {
    const pagePosts = posts.slice((n - 1) * perPage, n * perPage);
    paths.push({
      // 第一页固定为 /blog/，不生成 /blog/page/1/，避免重复内容
      params: { page: n === 1 ? undefined : `page/${n}` },
      props: {
        pagePosts,
        currentPage: n,
        totalPages,
        total: posts.length,
        prevUrl: n > 1 ? (n === 2 ? "/blog/" : `/blog/page/${n - 1}/`) : undefined,
        nextUrl: n < totalPages ? `/blog/page/${n + 1}/` : undefined,
      },
    });
  }
  return paths;
}

interface Props {
  pagePosts: Post[];
  currentPage: number;
  totalPages: number;
  total: number;
  prevUrl: string | undefined;
  nextUrl: string | undefined;
}

const { pagePosts, currentPage, totalPages, total, prevUrl, nextUrl } =
  Astro.props as Props;
const posts = await getPublishedPosts();
const tags = allTags(posts);
---

<BaseLayout
  title={currentPage === 1 ? "博客" : `博客 · 第 ${currentPage} 页`}
  description={`${SITE.name} 的全部文章：AI、网站、SEO、海外工具、数码与创业的实战记录。`}
  path={currentPage === 1 ? "/blog/" : `/blog/page/${currentPage}/`}
>
  <section class="section">
    <div class="container">
      <h1 class="page-title">博客</h1>
      <p class="section-sub">
        共 {total} 篇文章，按发布时间排序{totalPages > 1 && ` · 第 ${currentPage} / ${totalPages} 页`}。
      </p>

      <div class="post-list">
        {pagePosts.map((post) => <ArticleCard post={post} />)}
      </div>

      {totalPages > 1 && (
        <nav class="pagination" aria-label="分页">
          {prevUrl && <a href={prevUrl}>← 上一页</a>}
          <span class="current">{currentPage}</span>
          {nextUrl && <a href={nextUrl}>下一页 →</a>}
        </nav>
      )}

      {tags.length > 0 && (
        <div class="tags-block">
          <h2 class="tags-title">按标签浏览</h2>
          <div class="tags-cloud">
            {tags.map(({ tag, count }) => (
              <a href={`/tags/${tagSlug(tag)}/`} class="tag">
                {tag} · {count}
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    font-size: 2.2rem;
    margin: 0 0 8px;
  }
  .tags-block {
    margin-top: 64px;
  }
  .tags-title {
    font-size: 1.3rem;
    margin: 0 0 16px;
  }
  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
