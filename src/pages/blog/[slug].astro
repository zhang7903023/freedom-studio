---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { render } from "astro:content";
import { getPublishedPosts, readingTime, formatDate, categoryUrl, relatedPosts, adjacentPosts, tagSlug } from "../../utils/posts";
import { resolveCover } from "../../utils/covers";
import { SITE } from "../../config";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, all: posts },
  }));
}

const { post, all } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, publishDate, updatedDate, category, tags } = post.data;
const cover = resolveCover(post.data.cover);
const url = `/blog/${post.id}/`;

const { newer, older } = adjacentPosts(post, all);
const related = relatedPosts(post, all);

const siteOrigin = Astro.site?.href ?? SITE.url;
const pageUrl = new URL(url, siteOrigin).href;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished: publishDate.toISOString(),
    dateModified: (updatedDate ?? publishDate).toISOString(),
    author: {
      "@type": "Person",
      name: SITE.nameEn,
      url: new URL("/about/", siteOrigin).href,
    },
    publisher: {
      "@type": "Organization",
      name: SITE.name,
      url: siteOrigin,
      logo: {
        "@type": "ImageObject",
        url: new URL("/favicon.svg", siteOrigin).href,
      },
    },
    mainEntityOfPage: pageUrl,
    keywords: tags.join(", "),
    articleSection: category,
    inLanguage: SITE.locale,
    ...(cover ? { image: new URL(cover.src, siteOrigin).href } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "首页", item: siteOrigin },
      {
        "@type": "ListItem",
        position: 2,
        name: "博客",
        item: new URL("/blog/", siteOrigin).href,
      },
      { "@type": "ListItem", position: 3, name: title, item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path={url}
  type="article"
  jsonLd={jsonLd}
  publishedTime={publishDate.toISOString()}
  modifiedTime={(updatedDate ?? publishDate).toISOString()}
  tags={tags}
>
  <div class="container post-container">
    <article class="post-layout">
      <div class="post-main">
        <header class="post-header">
          <a href={categoryUrl(category)} class="badge">{category}</a>
          <h1 class="post-title">{title}</h1>
          <div class="post-meta meta">
            <span>发布于 {formatDate(publishDate)}</span>
            {updatedDate && <span>更新于 {formatDate(updatedDate)}</span>}
            <span>阅读约 {readingTime(post)}</span>
          </div>
        </header>

        {cover && (
          <Image
            src={cover}
            alt={title}
            widths={[720, 1080]}
            sizes="(max-width: 1080px) 100vw, 672px"
            loading="eager"
            class="post-cover"
          />
        )}

        <div class="toc-mobile">
          <TableOfContents headings={headings} />
        </div>

        <div class="prose">
          <Content />
        </div>

        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map((t) => (
              <a href={`/tags/${tagSlug(t)}/`} class="tag">{t}</a>
            ))}
          </div>
        )}

        <p class="rss-hint">喜欢这类内容？<a href="/rss.xml">订阅 RSS</a>，新文章会第一时间推送给你。</p>

        <div class="post-nav">
          <a href="/blog/" class="back-link">← 返回博客</a>
          <div class="adjacent">
            {older && (
              <a href={`/blog/${older.id}/`} class="adj-item">
                <span class="adj-label">← 上一篇</span>
                <span class="adj-title">{older.data.title}</span>
              </a>
            )}
            {newer && (
              <a href={`/blog/${newer.id}/`} class="adj-item adj-right">
                <span class="adj-label">下一篇 →</span>
                <span class="adj-title">{newer.data.title}</span>
              </a>
            )}
          </div>
        </div>

        {related.length > 0 && (
          <section class="related">
            <h2 class="related-title">相关文章</h2>
            <div class="article-grid">
              {related.map((p) => <ArticleCard post={p} />)}
            </div>
          </section>
        )}
      </div>

      <aside class="post-toc">
        <TableOfContents headings={headings} />
      </aside>
    </article>
  </div>
</BaseLayout>

<style>
  .post-container {
    padding-top: 48px;
  }
  .post-header {
    margin-bottom: 32px;
  }
  .post-title {
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    margin: 14px 0 12px;
    letter-spacing: -0.02em;
  }
  .post-meta {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
  }
  .post-cover {
    margin-bottom: 32px;
    border-radius: var(--radius);
  }
  .post-tags {
    margin-top: 40px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .rss-hint {
    margin-top: 28px;
    font-size: 0.92rem;
    color: var(--text-secondary);
  }
  .rss-hint a {
    color: var(--accent);
    text-decoration: underline;
  }
  .rss-hint a:hover {
    text-decoration: none;
  }
  .post-nav {
    margin-top: 48px;
    border-top: 1px solid var(--border);
    padding-top: 24px;
  }
  .back-link {
    font-size: 0.95rem;
  }
  .adjacent {
    margin-top: 20px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .adj-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 46%;
    color: var(--text);
  }
  .adj-item:hover {
    text-decoration: none;
  }
  .adj-right {
    margin-left: auto;
    text-align: right;
  }
  .adj-label {
    color: var(--text-secondary);
    font-size: 0.82rem;
  }
  .adj-title {
    font-weight: 500;
    font-size: 0.95rem;
  }
  .adj-item:hover .adj-title {
    color: var(--accent);
  }
  .related {
    margin-top: 64px;
  }
  .related-title {
    font-size: 1.3rem;
    margin: 0 0 20px;
  }

  /* 手机端 TOC 在正文顶部，桌面上移到右侧 */
  .toc-mobile {
    display: none;
  }
  @media (max-width: 1080px) {
    .toc-mobile {
      display: block;
      margin-bottom: 32px;
    }
    .post-toc {
      display: none;
    }
  }
</style>
