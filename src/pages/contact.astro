---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CONTACT, SITE } from "../config";

const channels = [
  { label: "Email", value: CONTACT.email, href: CONTACT.email ? `mailto:${CONTACT.email}` : "" },
  { label: "微信", value: CONTACT.wechat, href: "" },
  { label: "Telegram", value: CONTACT.telegram, href: CONTACT.telegram ? `https://t.me/${CONTACT.telegram.replace("@", "")}` : "" },
  { label: "WhatsApp", value: CONTACT.whatsapp, href: CONTACT.whatsapp ? `https://wa.me/${CONTACT.whatsapp.replace(/[^0-9]/g, "")}` : "" },
  { label: "X", value: CONTACT.x, href: CONTACT.x ? `https://x.com/${CONTACT.x.replace("@", "")}` : "" },
  { label: "YouTube", value: CONTACT.youtube, href: CONTACT.youtube },
].filter((c) => c.value);
---

<BaseLayout
  title="联系"
  description={`联系${SITE.name}：通过 Email、微信、Telegram 等方式取得联系。`}
  path="/contact/"
>
  <section class="section">
    <div class="container narrow">
      <h1 class="page-title">联系</h1>
      <p class="section-sub">
        有问题、有需求，或者只是想交流，都可以联系我。说明来意，回复会更快。
      </p>

      {channels.length > 0 ? (
        <ul class="contact-list">
          {channels.map((c) => (
            <li>
              <span class="ch-label">
                <span class="channel-icon" aria-hidden="true">
                  {c.label === "Email" && (
                    <svg viewBox="0 0 24 24"><path d="M3 5.5h18v13H3z"/><path d="m4 7 8 6 8-6"/></svg>
                  )}
                  {c.label === "微信" && (
                    <svg viewBox="0 0 24 24"><path d="M9.5 6C5.9 6 3 8.3 3 11.1c0 1.6 1 3.1 2.6 4.1L5 18l3.1-1.5c.5.1.9.1 1.4.1 3.6 0 6.5-2.3 6.5-5.1S13.1 6 9.5 6Z"/><path d="M14.3 10.2c3.7-.4 6.7 1.5 6.7 4.2 0 1.3-.8 2.5-2.1 3.3l.4 2-2.5-1.2c-.4.1-.8.1-1.2.1-2.2 0-4.1-1-5.1-2.4"/></svg>
                  )}
                  {c.label === "WhatsApp" && (
                    <svg viewBox="0 0 24 24"><path d="M12 3.5a8.5 8.5 0 0 0-7.4 12.7L3.5 20.5l4.5-1.1A8.5 8.5 0 1 0 12 3.5Z"/><path d="M8.4 8.5c.2-.4.5-.4.8-.4h.5c.2 0 .4.2.5.5l.6 1.4c.1.2.1.4-.1.6l-.5.6c.5 1 1.3 1.7 2.3 2.2l.6-.5c.2-.2.4-.2.6-.1l1.4.7c.3.1.4.3.3.6-.2.7-.8 1.2-1.5 1.2-2.9-.1-5.9-2.8-6.2-5.8-.1-.4.1-.7.7-1Z"/></svg>
                  )}
                  {c.label === "X" && (
                    <svg viewBox="0 0 24 24"><path d="M5 4h4.2l3.2 4.6L16.2 4H19l-5.2 6.1L19.5 20h-4.2l-3.8-5.3L6.8 20H4l5.4-6.7L5 4Z"/></svg>
                  )}
                  {c.label === "YouTube" && (
                    <svg viewBox="0 0 24 24"><path d="M21 8.2a2.5 2.5 0 0 0-1.8-1.8C17.6 6 12 6 12 6s-5.6 0-7.2.4A2.5 2.5 0 0 0 3 8.2 26 26 0 0 0 2.6 12c0 1.3.1 2.6.4 3.8a2.5 2.5 0 0 0 1.8 1.8C6.4 18 12 18 12 18s5.6 0 7.2-.4a2.5 2.5 0 0 0 1.8-1.8c.3-1.2.4-2.5.4-3.8s-.1-2.6-.4-3.8Z"/><path d="m10 9 5 3-5 3V9Z" fill="currentColor" stroke="none"/></svg>
                  )}
                </span>
                {c.label}
              </span>
              {c.href ? (
                <a href={c.href} target={c.href.startsWith("http") ? "_blank" : undefined} rel="noopener noreferrer">{c.value}</a>
              ) : (
                <span class="ch-value">{c.value}</span>
              )}
            </li>
          ))}
        </ul>
      ) : (
        <div class="placeholder">
          <p>联系方式正在整理中。</p>
          <p class="hint">可以先阅读博客文章了解我在做的事，联系方式放出来后会第一时间更新在这里。</p>
          <p><a href="/about/">了解我 →</a></p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 640px;
  }
  .page-title {
    font-size: 2.2rem;
    margin: 0 0 8px;
  }
  .contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .contact-list li {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 16px 4px;
    border-bottom: 1px solid var(--border);
  }
  .ch-label {
    width: 108px;
    color: var(--text-secondary);
    font-size: 0.9rem;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .channel-icon {
    width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-primary);
  }
  .channel-icon svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }
  .placeholder {
    padding: 32px 0;
    color: var(--text-secondary);
  }
  .placeholder .hint {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }
  .placeholder a {
    color: var(--accent);
    text-decoration: none;
  }
  .placeholder a:hover {
    text-decoration: underline;
  }
</style>
