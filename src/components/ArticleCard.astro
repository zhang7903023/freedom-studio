---
import { Image } from "astro:assets";
import type { Post } from "../utils/posts";
import { formatDate, readingTime, categoryUrl } from "../utils/posts";
import { resolveCover } from "../utils/covers";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, publishDate, category } = post.data;
const cover = resolveCover(post.data.cover);
const url = `/blog/${post.id}/`;
---

<article class="article-card">
  {cover && (
    <a href={url} class="card-cover-link" tabindex="-1" aria-hidden="true">
      <Image
        src={cover}
        alt=""
        widths={[400, 800]}
        sizes="(max-width: 600px) 100vw, 360px"
        loading="lazy"
        decoding="async"
        class="card-cover"
      />
    </a>
  )}
  <div class="card-body">
    <div class="card-meta">
      <a href={categoryUrl(category)} class="badge">{category}</a>
      <span class="meta">{formatDate(publishDate)} · {readingTime(post)}</span>
    </div>
    <h3 class="card-title">
      <a href={url}>{title}</a>
    </h3>
    <p class="card-desc">{description}</p>
  </div>
</article>

<style>
  .article-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }
  .article-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }
  .card-cover-link {
    display: block;
  }
  .card-cover {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    border-radius: 0;
  }
  .card-body {
    padding: 20px 22px 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .card-title {
    font-size: 1.08rem;
    margin: 0 0 8px;
    line-height: 1.45;
  }
  .card-title a {
    color: var(--text);
  }
  .card-title a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .card-desc {
    color: var(--text-secondary);
    font-size: 0.92rem;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.65;
  }
</style>
