---
import { SITE } from "../config";

interface Props {
  /** 页面 title（已含站名或会自动拼接） */
  title?: string;
  description: string;
  /** 相对路径，如 /blog/xxx/ */
  path?: string;
  image?: string;
  type?: "website" | "article";
  /** 附加 JSON-LD 结构化数据 */
  jsonLd?: Record<string, unknown>[];
  /** 文章发布/更新时间（type=article 时用于 OG） */
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  /** 是否输出 WebSite / Organization 全站结构化数据（仅首页传 true） */
  includeSiteSchema?: boolean;
}

const {
  title,
  description,
  path = "",
  image = SITE.ogImage,
  type = "website",
  jsonLd = [],
  publishedTime,
  modifiedTime,
  tags = [],
  includeSiteSchema = false,
} = Astro.props;

const siteOrigin = Astro.site?.href ?? SITE.url;
const fullTitle =
  title && title !== SITE.name ? `${title}｜${SITE.name}` : title || SITE.title;
const canonical = new URL(path, siteOrigin).href;
const ogImage = new URL(image, siteOrigin).href;
const logoUrl = new URL("/favicon.svg", siteOrigin).href;

const siteJsonLd: Record<string, unknown>[] = includeSiteSchema
  ? [
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: SITE.name,
        alternateName: SITE.nameEn,
        url: siteOrigin,
        description: SITE.description,
        inLanguage: SITE.locale,
        publisher: {
          "@type": "Organization",
          name: SITE.name,
          url: siteOrigin,
          logo: { "@type": "ImageObject", url: logoUrl },
        },
      },
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        name: SITE.name,
        alternateName: SITE.nameEn,
        url: siteOrigin,
        description: SITE.description,
        logo: { "@type": "ImageObject", url: logoUrl },
      },
    ]
  : [];

const allJsonLd = [...siteJsonLd, ...jsonLd];
---

<!-- SEO -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE.name}
  href={new URL("rss.xml", siteOrigin).href}
/>
<meta name="generator" content={Astro.generator} />

<!-- Open Graph -->
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={SITE.locale} />
{
  type === "article" && publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )
}
{
  type === "article" && modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime} />
  )
}
{type === "article" && tags.map((t) => <meta property="article:tag" content={t} />)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- JSON-LD -->
{allJsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
