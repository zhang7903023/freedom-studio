---
import type { Post } from "../utils/posts";
import { formatDate, categoryUrl } from "../utils/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, publishDate, category } = post.data;
const url = `/blog/${post.id}/`;
---

<article class="post-row">
  <div class="post-row-meta">
    <a href={categoryUrl(category)}>{category}</a>
    <br />
    <time datetime={publishDate.toISOString()}>{formatDate(publishDate)}</time>
  </div>
  <div class="post-row-body">
    <h3 class="post-row-title">
      <a href={url}>{title}</a>
    </h3>
    <p class="post-row-desc">{description}</p>
  </div>
  <span class="post-row-arrow" aria-hidden="true">→</span>
</article>
