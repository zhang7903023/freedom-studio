---
import { SOCIAL, CONTACT } from "../config";

const year = new Date().getFullYear();

const footerLinks = [
  { label: "X", href: SOCIAL.x, external: true },
  { label: "YouTube", href: SOCIAL.youtube, external: true },
  { label: "Telegram", href: SOCIAL.telegram, external: true },
  { label: "Email", href: CONTACT.email ? `mailto:${CONTACT.email}` : "", external: false },
  { label: "RSS", href: "/rss.xml", external: false },
].filter((l) => l.href);
---

<footer class="footer">
  <div class="container footer-inner">
    <span>© {year}</span>
    <ul class="footer-links">
      {footerLinks.map((l) => (
        <li>
          {l.external ? (
            <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
          ) : (
            <a href={l.href}>{l.label}</a>
          )}
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .footer-links {
    list-style: none;
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 0;
  }
</style>
