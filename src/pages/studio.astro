---
import '../styles/studio.css';
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/><meta name="robots" content="noindex,nofollow"/><title>创作室 · X</title></head><body>
<header class="top"><a href="/" class="brand">X <span>创作室</span></a><span id="save-state" role="status">正在读取草稿</span><button id="preview-toggle" class="primary">预览文章</button></header>
<main class="workspace"><section class="compose"><div class="intro"><p class="eyebrow">YOUR NEXT STORY</p><h1>把经历，写下来。</h1><p>选一个起点，然后写成你自己的故事。</p></div>
<div class="templates" aria-label="内容模板"><button data-template="daily">01 <b>日常图文</b><small>记录片刻与发现</small></button><button data-template="tutorial">02 <b>步骤教程</b><small>把方法讲清楚</small></button><button data-template="review">03 <b>体验测评</b><small>真实感受与取舍</small></button><button data-template="pitfall">04 <b>踩坑记录</b><small>问题、过程、答案</small></button></div>
<div class="paper"><label class="sr-only" for="post-title">文章标题</label><input id="post-title" class="title-input" placeholder="给这篇故事起个标题" maxlength="160"/><label class="sr-only" for="post-summary">文章摘要</label><textarea id="post-summary" rows="2" placeholder="一句话介绍这篇内容（可选）"></textarea><div class="toolbar" aria-label="正文格式"><button data-command="bold">加粗</button><button data-command="heading">小标题</button><button data-command="bullet">列表</button><button data-command="quote">引用</button><button data-command="undo">撤销</button><button data-photo="up">照片上移</button><button data-photo="down">照片下移</button><button data-photo="delete">删除照片</button><label class="file-button">插入照片<input id="body-images" type="file" accept="image/*" multiple hidden/></label></div><div id="editor"></div><p id="image-status" role="status" class="hint"></p></div>
<details class="cover-panel"><summary>封面设计 <span>换图 · 改字 · 导出</span></summary><div id="cover-editor"></div></details>
<div class="settings"><label>文章排版<select id="article-layout"><option value="plain">简洁长文</option><option value="editorial">杂志图文</option><option value="notes">笔记卡片</option></select></label><div class="backup"><button id="download-draft">备份草稿</button><label class="file-button">恢复备份<input id="restore-draft" type="file" accept="application/json,.json" hidden/></label><button id="download-html">导出文章</button></div></div>
<p class="hint">本版草稿保存在当前浏览器。云端同步、AI 生成与直接发布尚未接入。<a href="/admin/">打开现有发布后台</a></p><p id="error" role="alert"></p></section>
<aside class="preview" aria-label="文章预览"><div class="preview-bar"><span>阅读预览</span><span id="word-count">0 字</span></div><article id="article-preview" class="plain"><img id="preview-cover" alt="文章封面" hidden/><p class="eyebrow">自由行Studio / JOURNAL</p><h1 id="preview-title">你的下一篇故事</h1><p id="preview-summary"></p><div id="preview-body" class="prose"></div></article></aside></main>
<script src="../scripts/studio.js"></script></body></html>
